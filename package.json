{
  "name": "@rakutek/dsh-intelligent-ui",
  "version": "0.1.0",
  "description": "Intelligent UI for DeepSeek Harness: the model writes markdown with component tags, expressions, and mermaid diagrams, and the chat renders them in place as live, interactive UI.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "generative-ui",
    "intelligent-ui",
    "mermaid"
  ],
  "author": "rakutek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakutek/dsh-intelligent-ui.git"
  },
  "homepage": "https://github.com/rakutek/dsh-intelligent-ui#readme",
  "bugs": {
    "url": "https://github.com/rakutek/dsh-intelligent-ui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.ja.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || >=4.0.5-alpha.0 <4.1.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
